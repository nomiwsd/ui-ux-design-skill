{
  "$schema": "https://design-tokens.org/schema.json",
  "_README": "TEMPLATE — NOT SHIPPABLE. Every #FF00FF (light) and #7FFF00 (dark) is a tripwire placeholder that must be replaced. If these render in a browser, the tokens were never chosen. Name by role, never by value. Neutrals tint toward the brand hue. Dark mode is designed independently, not inverted.",
  "color": {
    "light": {
      "bg-canvas": "#FF00FF",
      "bg-surface": "#FF00FF",
      "bg-raised": "#FF00FF",
      "bg-inset": "#FF00FF",
      "text-primary": "#FF00FF",
      "text-secondary": "#FF00FF",
      "text-muted": "#FF00FF",
      "text-inverse": "#FF00FF",
      "border-subtle": "#FF00FF",
      "border-strong": "#FF00FF",
      "accent": "#FF00FF",
      "accent-hover": "#FF00FF",
      "accent-subtle": "#FF00FF",
      "accent-fg": "#FF00FF",
      "success": "#FF00FF",
      "warning": "#FF00FF",
      "danger": "#FF00FF",
      "info": "#FF00FF"
    },
    "dark": {
      "_note": "Base 8-12% lightness, never #000. Elevation by lightness. Accents desaturated ~20 points. Text off-white, never #FFF.",
      "bg-canvas": "#7FFF00",
      "bg-surface": "#7FFF00",
      "bg-raised": "#7FFF00",
      "bg-inset": "#7FFF00",
      "text-primary": "#7FFF00",
      "text-secondary": "#7FFF00",
      "text-muted": "#7FFF00",
      "text-inverse": "#7FFF00",
      "border-subtle": "#7FFF00",
      "border-strong": "#7FFF00",
      "accent": "#7FFF00",
      "accent-hover": "#7FFF00",
      "accent-subtle": "#7FFF00",
      "accent-fg": "#7FFF00",
      "success": "#7FFF00",
      "warning": "#7FFF00",
      "danger": "#7FFF00",
      "info": "#7FFF00"
    }
  },
  "font": {
    "_note": "Two faces max, fixed roles. Do not default to Inter/Poppins/Montserrat as display.",
    "display": "CHOOSE-DISPLAY-FACE, Georgia, serif",
    "sans": "CHOOSE-BODY-FACE, system-ui, sans-serif",
    "mono": "CHOOSE-MONO-FACE, ui-monospace, monospace"
  },
  "fontSize": {
    "_note": "Generated from a ratio (1.25 dense / 1.333+ marketing). Push display-to-body past 3.5x unless utilitarian-dense.",
    "display": "clamp(2.5rem, 1.4rem + 4.6vw, 4.75rem)",
    "h1": "clamp(2rem, 1.3rem + 2.8vw, 3.5rem)",
    "h2": "clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem)",
    "h3": "clamp(1.3rem, 1.1rem + 0.8vw, 1.75rem)",
    "lg": "1.125rem",
    "base": "1rem",
    "sm": "0.875rem",
    "xs": "0.8125rem"
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px", "16": "64px", "24": "96px", "32": "128px" },
  "radius": {
    "_note": "CHOOSE one position on the sharp<->soft axis and hold it.",
    "sm": "6px", "md": "12px", "lg": "24px", "full": "999px"
  },
  "duration": { "instant": "80ms", "fast": "150ms", "base": "250ms", "slow": "400ms", "slower": "600ms" },
  "easing": {
    "out": "cubic-bezier(0.22, 1, 0.36, 1)",
    "in": "cubic-bezier(0.55, 0, 1, 0.45)",
    "inOut": "cubic-bezier(0.65, 0, 0.35, 1)",
    "emphasis": "cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "stagger": "60ms"
}
